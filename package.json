{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d --wait postgres && next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "pnpm test:e2e --config playwright.auth.config.ts",
    "test:auth-harness": "node --test --test-concurrency=1 tests/auth-harness/*.test.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "api:check": "node scripts/check-api-handlers.mjs",
    "db:rate-limit:prune": "node scripts/rate-limit-prune.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "dependencies": {
    "@next/env": "^16.3.7",
    "@sentry/nextjs": "^11.5.0",
    "drizzle-orm": "^0.45.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "firebase-tools": "15.33.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
