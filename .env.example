# Matches the local PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql://starter:starter@127.0.0.1:5432/starter

# Regular-user Firebase project web app configuration (public values).
NEXT_PUBLIC_FIREBASE_USER_API_KEY=
NEXT_PUBLIC_FIREBASE_USER_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_USER_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_USER_APP_ID=

# Regular-user Firebase Admin service account (server-only).
FIREBASE_USER_PROJECT_ID=
FIREBASE_USER_CLIENT_EMAIL=
FIREBASE_USER_PRIVATE_KEY=

# Staff Firebase project web app configuration (public values).
NEXT_PUBLIC_FIREBASE_STAFF_API_KEY=
NEXT_PUBLIC_FIREBASE_STAFF_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STAFF_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STAFF_APP_ID=

# Staff Firebase Admin service account (server-only).
FIREBASE_STAFF_PROJECT_ID=
FIREBASE_STAFF_CLIENT_EMAIL=
FIREBASE_STAFF_PRIVATE_KEY=

# Sentry error reporting: configure both DSNs in Vercel Production and Preview.
# Normal local development and CI do not report, even with a DSN configured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Build-time source-map upload settings (auth token is secret/server-only).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional release fallback; Vercel's commit SHA takes precedence.
SENTRY_RELEASE=

# Pino: info on Vercel, debug locally; silent disables app logs.
LOG_LEVEL=
